<RCC>
    <qresource prefix="/binaries">
        <file>atari/autoboot/autoboot.bin</file>
        <file>atari/autoboot/autoboot-hispeed.bin</file>
    </qresource>
    <qresource prefix="/hisio">
        <file alias="hisioboot.atr">atari/hisioboot/hisioboot-atarisio.atr</file>
    </qresource>
    <qresource prefix="/dos">
        <file alias="boot.bin">dosassets/boot.bin</file>
        <file alias="picodos.sys">dosassets/picodos.sys</file>
    </qresource>
    <qresource prefix="/data">
        <file alias="phonebook.xml">phonebook.xml</file>
    </qresource>
    <qresource prefix="/printer">
        <file>printer/epson-test.prn</file>
    </qresource>
</RCC>
